{#
    settings.twig — the CMS settings page (admin/settings/index.php)

    Built entirely from SECTIONS (SettingsForm::view()): one card per
    registry section, one row per field the user may see. Behaviour lives in
    admin/settings/settings.js:
      - submit → fetch save.php, toast + errors at the fields, no reload
      - [data-advanced] rows only while "show advanced" is on (remembered);
        the switch sits in every card head, the clicked card stays in place
      - [data-depends] rows only while the named field has the given value
      - the test mail button saves pending changes first

    Every switch and checkbox group posts a hidden "off" value first, so an
    unchecked box still reaches save.php — a field absent from the POST is
    left unchanged.

    The backend's Twig runs WITHOUT autoescape (TwigLoader.php): every
    stored value printed here needs an explicit |e.
#}

{% macro field(name, f) %}
    {% set id = 'set_' ~ name %}
    {% if f.type == 'bool' %}
        <input type="hidden" name="{{ name }}" value="{{ f.values[1]|e }}">
        <span>
            <input type="checkbox" switch="bool" name="{{ name }}" id="{{ id }}"
                   value="{{ f.values[0]|e }}"{% if f.value == f.values[0] %} checked{% endif %}>
            <label for="{{ id }}" class="labeled"
                   data-on-label="{{ L_('TEXT:ENABLED')|e }}"
                   data-off-label="{{ L_('TEXT:DISABLED')|e }}"></label>
        </span>
    {% elseif f.type == 'select' or f.type == 'timezone' %}
        {# wbeSelect (settings.js) — data-ws: its options from the registry #}
        <select name="{{ name }}" id="{{ id }}" class="ws-select"
                data-ws="{{ (f.widget ?? {})|json_encode|e }}"
                data-search-label="{{ L_('TEXT:SEARCH')|e }} &hellip;">
            {# group_start/group_end: <optgroup> (the time zone choice);
               keywords: searched by wbeSelect (searchFields), not shown #}
            {% for c in f.choices %}
                {% if c.group_start is defined %}<optgroup label="{{ c.group_start|e }}">{% endif %}
                <option value="{{ c.value|e }}"
                    {%- if c.right is defined %} data-right="{{ c.right|e }}"{% endif %}
                    {%- if c.left is defined %} data-left="{{ c.left|e }}"{% endif %}
                    {%- if c.keywords ?? '' %} data-keywords="{{ c.keywords|e }}"{% endif %}
                    {%- if c.selected is defined ? c.selected : c.value == f.value %} selected{% endif %}>{{ c.label|e }}</option>
                {% if c.group_end ?? false %}</optgroup>{% endif %}
            {% endfor %}
        </select>
    {% elseif f.type == 'radio' %}
        {# segmented control (cp_chrome.css); the first segment carries the
           id the row label points to #}
        <div class="radio-switch-group">
            {% for value, label in f.options %}
                {% set rid = loop.first ? id : id ~ '_' ~ value %}
                <input type="radio" class="switch-radio" name="{{ name }}" id="{{ rid|e }}" value="{{ value|e }}"{% if value ~ '' == f.value %} checked{% endif %}><label for="{{ rid|e }}">{{ label|e }}</label>
            {% endfor %}
        </div>
    {% elseif f.type == 'number' %}
        <input type="number" name="{{ name }}" id="{{ id }}" value="{{ f.value|e }}"
               {% if f.min is defined %}min="{{ f.min }}"{% endif %} {% if f.max is defined %}max="{{ f.max }}"{% endif %}>
    {% elseif f.type == 'password' %}
        <input type="password" name="{{ name }}" id="{{ id }}" value="" autocomplete="new-password"
               placeholder="{{ f.is_set ? '••••••••' : '' }}">
    {% elseif f.type == 'textarea' %}
        <textarea name="{{ name }}" id="{{ id }}" rows="3"{% if f.mono ?? false %} class="cp-mono"{% endif %}>{{ f.value|e }}</textarea>
    {% elseif f.type == 'html' %}
        {# |e matters here most: a "</textarea>" in the stored HTML would
           otherwise end the field and spill into the page #}
        <textarea name="{{ name }}" id="{{ id }}" rows="4" spellcheck="false" class="cp-code">{{ f.value|e }}</textarea>
    {% elseif f.type == 'filemode' %}
        <input type="hidden" name="{{ name }}[]" value="">
        <table class="cp-filemode" id="{{ id }}">
            <thead>
                <tr><th></th><th>{{ L_('TEXT:USER') }}</th><th>{{ L_('TEXT:GROUP') }}</th><th>{{ L_('TEXT:OTHERS') }}</th></tr>
            </thead>
            <tbody>
                {% for perm, permLabel in {'r': 'TEXT:READ', 'w': 'TEXT:WRITE', 'e': 'TEXT:EXECUTE'} %}
                    <tr>
                        <th>{{ L_(permLabel) }}</th>
                        {% for who in ['u', 'g', 'o'] %}
                            <td><input type="checkbox" name="{{ name }}[]" value="{{ who }}_{{ perm }}"
                                       {% if (who ~ '_' ~ perm) in f.bits %} checked{% endif %}></td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        {% set cls = [(f.wide ?? false) ? 'cp-full', (f.mono ?? false) ? 'cp-mono']|filter(c => c) %}
        <input type="text" name="{{ name }}" id="{{ id }}" value="{{ f.value|e }}"{% if cls %} class="{{ cls|join(' ') }}"{% endif %}>
    {% endif %}
    {% if f.counter is defined %}
        {# filled by settings.js; limits from wbSeoTool's seo_cfg #}
        <div class="cp-counter" data-for="{{ id }}"
             data-min="{{ f.counter.min }}" data-optimum="{{ f.counter.optimum }}"
             data-remaining="{{ f.counter.remaining ? 1 : 0 }}"></div>
    {% endif %}
{% endmacro %}
{% import _self as settings %}

<section class="cp-main" id="wbce-settings">
    <div class="cp-pageinfo"></div>
    <div id="message-area">{{ MESSAGE_BOX|raw }}</div>
    <nav class="cp-tabs tabs-right">
        <ul>
            <li class="area-title">{{ L_('MENU:SETTINGS') }}</li>
        </ul>
    </nav>
    <div class="cp-pane-inlay">
        <noscript><div class="alert alert-danger">JavaScript is required to save the settings.</div></noscript>

        <form id="settings-form" method="post" action="{{ SAVE_URL|e }}" novalidate
              data-label-show="{{ L_('TEXT:SHOW_ADVANCED')|e }}"
              data-label-hide="{{ L_('TEXT:HIDE_ADVANCED')|e }}"
              data-testmail-url="{{ TESTMAIL_URL|e }}"
              data-msg-error="{{ L_('TEXT:ERROR')|e }}"
              data-counter-left="{{ L_('MESSAGE:SETTINGS_COUNTER_LEFT')|e }}"
              data-counter-over="{{ L_('MESSAGE:SETTINGS_COUNTER_OVER')|e }}">
            <input type="hidden" name="settings_token" value="{{ TOKEN|e }}">

            {% for key, section in SECTIONS %}
            <div class="cp-settings" id="{{ key }}">
                <div class="cp-toggle-section">
                    <div class="cp-card-head">
                        <label><i class="fa {{ section.icon }}"></i> {{ L_(section.heading) }}</label>
                        {% if IS_ADVANCED %}
                        {# one state for all cards; each card carries the switch #}
                        <button type="button" class="cp-head-link pull-right settings-advanced-toggle">
                            <span>{{ L_('TEXT:SHOW_ADVANCED') }} &raquo;</span>
                        </button>
                        {% endif %}
                    </div>
                    <section>
                        {% if key == 'mailer' %}
                            {% if MAIL_OVERRIDE %}
                            <div class="cp-setting-row wide"><div class="alert alert-warning">{{ L_('HEADING:WBMAILER_CFG_OVERRIDE_HINT')|raw }}</div></div>
                            {% endif %}
                            <div class="cp-setting-row wide"><div class="cp-setting-hint">{{ L_('TEXT:WBMAILER_DEFAULT_SETTINGS_NOTICE')|raw }}</div></div>
                        {% endif %}

                        {% for name, f in section.fields %}
                        <div class="cp-setting-row" data-field="{{ name }}"
                             {% if f.advanced %}data-advanced{% endif %}
                             {% if f.depends is defined %}data-depends="{{ f.depends[0]|e }}" data-depends-value="{{ f.depends[1]|e }}"{% endif %}>
                            <label class="cp-setting-name" for="set_{{ name }}">{{ L_(f.label) }}</label>
                            <div class="cp-setting-value">
                                {{ settings.field(name, f) }}
                                {% if f.hint is defined %}
                                    {# plain text — e.g. "<meta:description>" must show as written #}
                                    <div class="cp-setting-hint">{{ f.hint|e }}</div>
                                {% endif %}
                                {% if f.warning is defined %}
                                    <div class="cp-setting-hint cp-setting-warning" data-warning-for="{{ name|e }}"><i class="fa fa-exclamation-triangle"></i> {{ f.warning|e }}</div>
                                {% endif %}
                                {% if name == 'search' and SEARCH_TOOL_URL %}
                                    <div class="cp-setting-hint"><a href="{{ SEARCH_TOOL_URL|e }}"><i class="fa fa-search"></i> {{ SEARCH_TOOL_NAME|e }} &raquo;</a></div>
                                {% endif %}
                                <div class="cp-setting-error" hidden></div>
                            </div>
                        </div>
                        {% endfor %}

                        {% if key == 'mailer' %}
                        <div class="cp-setting-row">
                            <span class="cp-setting-name"></span>
                            <div class="cp-setting-value">
                                <span><button type="button" class="button" id="settings-testmail">
                                    <i class="fa fa-paper-plane"></i> {{ L_('TEXT:BUTTON_SEND_TESTMAIL') }}
                                </button></span>
                                <div class="cp-setting-hint">{{ L_('TEXT:SEND_TESTMAIL') }}</div>
                            </div>
                        </div>
                        {% endif %}

                        <div class="cp-buttons-row">
                            <button type="submit" class="button ico-save pos-right">{{ L_('TEXT:SAVE') }}</button>
                        </div>
                    </section>
                </div>
            </div>
            {% endfor %}
        </form>
    </div>
</section>
